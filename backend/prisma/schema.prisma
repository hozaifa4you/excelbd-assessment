generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  DELIVERY_AGENT
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName     String
  lastName      String
  avatar        String?  @default("avatar.png")
  username      String   @unique
  email         String   @unique
  phone         String?  @unique
  password      String
  role          Role     @default(USER)
  rememberToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Parcel        Parcel[]
  DeliveryAgent Parcel[] @relation("ParcelDeliveryAgent")

  @@map("Users")
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  address   Address?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Parcel    Parcel[]

  @@map("Customers")
}

type Address {
  street  String
  city    String
  state   String
  country String
  zip     String?
}

enum ParcelStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  COD
  PAID
}

model Parcel {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  parcelType        String
  weight            Float
  dimensions        String?
  status            ParcelStatus  @default(PENDING)
  sender            User          @relation(fields: [senderId], references: [id])
  senderId          String        @db.ObjectId
  recipient         Customer      @relation(fields: [recipientId], references: [id])
  recipientId       String        @db.ObjectId
  pickupAddress     Address
  deliveryAddress   Address
  deliveryAgent     User?         @relation("ParcelDeliveryAgent", fields: [deliveryAgentId], references: [id])
  deliveryAgentId   String?       @db.ObjectId
  trackingNumber    String        @unique
  deliveryFee       Float
  paymentStatus     PaymentStatus
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("Parcels")
}
